// std.bytes: byte-order conversions and bounded binary reads.

@derive(Eq)
pub enum Endian {
    Big
    Little
}

fn pack(value: U64, width: Int, order: Endian) -> List<U8> {
    let out: List<U8> = List.with_capacity(width)
    for i in 0..width {
        let shift = if order == Endian.Big { width - 1 - i } else { i }
        let shift_bits = (8 * shift).wrap_to_u64()
        out.push((value >> shift_bits).wrap_to_u8())
    }
    out
}

pub fn pack_u16(value: U16, order: Endian) -> List<U8> { pack(value.wrap_to_u64(), 2, order) }
pub fn pack_u32(value: U32, order: Endian) -> List<U8> { pack(value.wrap_to_u64(), 4, order) }
pub fn pack_u64(value: U64, order: Endian) -> List<U8> { pack(value, 8, order) }

/// A cursor over a snapshot of the input. Failed reads leave the position unchanged.
pub struct Reader {
    data: List<U8>
    var pos: Int
}

impl Reader {
    pub fn new(data: List<U8>) -> Reader { Reader { data: data.copy(), pos: 0 } }

    pub fn position(self) -> Int { self.pos }
    pub fn remaining(self) -> Int { self.data.len() - self.pos }

    pub fn skip(self, count: Int) -> Bool {
        if count < 0 || count > self.remaining() { return false }
        self.pos += count
        true
    }

    pub fn read(self, count: Int) -> Option<List<U8>> {
        let start = self.pos
        if !self.skip(count) { return None }
        Some(self.data.slice(start, self.pos))
    }

    pub fn read_u8(self) -> Option<U8> {
        let value = self.data.get(self.pos)?
        self.pos += 1
        Some(value)
    }

    fn unpack(self, width: Int, order: Endian) -> Option<U64> {
        let start = self.pos
        if !self.skip(width) { return None }
        var value: U64 = 0
        for i in 0..width {
            let offset = if order == Endian.Big { i } else { width - 1 - i }
            value = (value << 8) | self.data[start + offset].wrap_to_u64()
        }
        Some(value)
    }

    pub fn read_u16(self, order: Endian) -> Option<U16> { Some(self.unpack(2, order)?.wrap_to_u16()) }
    pub fn read_u32(self, order: Endian) -> Option<U32> { Some(self.unpack(4, order)?.wrap_to_u32()) }
    pub fn read_u64(self, order: Endian) -> Option<U64> { self.unpack(8, order) }
}
