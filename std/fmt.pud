// std.fmt: formatting values and integers.

pub fn join<T: Show>(values: List<T>, separator: Str) -> Str {
    let out = StrBuilder.new()
    for (index, value) in values.enumerate() {
        if index > 0 { out.push(separator) }
        out.push(value.show())
    }
    out.to_str()
}

/// Formats an unsigned integer with lowercase digits in a base from 2 to 36.
pub fn uint_radix(value: U64, base: Int) -> Option<Str> {
    if base < 2 || base > 36 { return None }
    let radix = base.wrap_to_u64()
    let digits: List<Char> = []
    var rest = value
    loop {
        let digit = (rest % radix).wrap_to_u32()
        let code = if digit < 10 { 48 + digit } else { 87 + digit }
        digits.push(Char.from_u32(code).unwrap())
        rest /= radix
        if rest == 0 { break }
    }
    digits.reverse()
    Some(Str.from_chars(digits))
}

/// Formats a signed integer with a leading minus sign for negative values.
pub fn int_radix(value: I64, base: Int) -> Option<Str> {
    if value >= 0 { return uint_radix(value.wrap_to_u64(), base) }
    let magnitude = (-(value + 1)).wrap_to_u64() + 1
    let digits = uint_radix(magnitude, base)?
    Some("-" + digits)
}

/// Parses ASCII digits in a base from 2 to 36.
pub fn parse_uint_radix(input: Str, base: Int) -> Option<U64> {
    if base < 2 || base > 36 || input.is_empty() { return None }
    let radix = base.wrap_to_u64()
    var value: U64 = 0
    for character in input.chars() {
        let digit = character.to_digit(base)?
        value = value.checked_mul(radix)?.checked_add(digit.wrap_to_u64())?
    }
    Some(value)
}

/// Parses ASCII digits and an optional leading plus or minus sign.
pub fn parse_int_radix(input: Str, base: Int) -> Option<I64> {
    let first = input.chars().next()?
    if first != '-' && first != '+' { return parse_uint_radix(input, base)?.to_i64() }
    let magnitude = parse_uint_radix(__str_slice(input, 1, input.utf8_len()), base)?
    if first == '+' { return magnitude.to_i64() }
    if magnitude == 9223372036854775808 { return Some(-9223372036854775808) }
    Some(0 - magnitude.to_i64()?)
}
