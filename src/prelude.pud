// The Puddi prelude. Available in every module without import.
// Numeric methods are generated by the compiler and appended to this file.

// ---------------------------------------------------------------- intrinsics

@intrinsic("array_new") fn __array_new<T>(n: Int) -> Array<T>
@intrinsic("array_len") fn __array_len<T>(a: Array<T>) -> Int
@intrinsic("array_get") fn __array_get<T>(a: Array<T>, i: Int) -> T
@intrinsic("array_set") fn __array_set<T>(a: Array<T>, i: Int, v: T)
@intrinsic("array_copy") fn __array_copy<T>(dst: Array<T>, di: Int, src: Array<T>, si: Int, n: Int)
@intrinsic("array_fill") fn __array_fill<T>(a: Array<T>, i: Int, v: T, n: Int)
@intrinsic("select") fn __select<T>(c: Bool, a: T, b: T) -> T
// answered during elaboration; `if __is_int<T>() { A } else { B }` elaborates only one branch
@intrinsic("is_int") fn __is_int<T>() -> Bool
@intrinsic("int_bits") fn __int_bits<T>() -> Int
@intrinsic("int_signed") fn __int_signed<T>() -> Bool
@intrinsic("array_get") fn __bytes_get(a: Array<U8>, i: Int) -> Int
@intrinsic("array_set") fn __bytes_set(a: Array<U8>, i: Int, v: Int)
@intrinsic("str_len") fn __str_len(s: Str) -> Int
@intrinsic("bytes_copy_str") fn __bytes_copy_str(dst: Array<U8>, di: Int, src: Str, si: Int, n: Int)
@intrinsic("str_byte") fn __str_byte(s: Str, i: Int) -> Int
@intrinsic("str_slice") fn __str_slice(s: Str, a: Int, b: Int) -> Str
@intrinsic("str_from_bytes") fn __str_from_bytes(a: Array<U8>, n: Int) -> Str
@intrinsic("str_concat") fn __str_concat(a: Str, b: Str) -> Str
@intrinsic("str_eq") fn __str_eq(a: Str, b: Str) -> Bool
@intrinsic("str_cmp") fn __str_cmp(a: Str, b: Str) -> Int
@intrinsic("print") fn __print(s: Str)
@intrinsic("eprint") fn __eprint(s: Str)
@intrinsic("fmt_f64") fn __fmt_f64(x: Float) -> Str
@intrinsic("fmt_f32") fn __fmt_f32(x: F32) -> Str
@intrinsic("parse_f64") fn __parse_f64(s: Str) -> Float
@intrinsic("host") fn __host(op: Int, arg: Str) -> Str
@intrinsic("host_ok") fn __host_ok() -> Bool
@intrinsic("cast") fn __cast<From, To>(x: From) -> To
@intrinsic("reinterpret") fn __reinterpret<From, To>(x: From) -> To
@intrinsic("wrapping") fn __wrapping<T>(op: Int, a: T, b: T) -> T
@intrinsic("overflows") fn __overflows<T>(op: Int, a: T, b: T) -> Bool
@intrinsic("fop") fn __fop<T>(op: Int, x: T) -> T
@intrinsic("fminmax") fn __fminmax<T>(op: Int, a: T, b: T) -> T
@intrinsic("fmath") fn __fmath(op: Int, x: Float, y: Float) -> Float
@intrinsic("dyn_is") fn __dyn_is<T, D>(d: D) -> Bool
@intrinsic("dyn_cast") fn __dyn_cast<T, D>(d: D) -> T

/// Stops the program with an error message. Cannot be caught.
@intrinsic("panic") pub fn panic(msg: Str) -> Never

/// True when `a` and `b` are the same object (reference identity).
@intrinsic("same") pub fn same<T>(a: T, b: T) -> Bool

/// Prints a value followed by a newline.
pub fn print<T: Show>(x: T) {
    __print("{x}\n")
}

/// Prints a value followed by a newline to the error stream.
pub fn eprint<T: Show>(x: T) {
    __eprint("{x}\n")
}

pub fn assert(cond: Bool) {
    if !cond {
        panic("assertion failed")
    }
}

pub fn assert_msg(cond: Bool, msg: Str) {
    if !cond {
        panic("assertion failed: {msg}")
    }
}

pub fn assert_eq<T: Eq + Show>(a: T, b: T) {
    if a != b {
        panic("assertion failed: {a.show_nested()} != {b.show_nested()}")
    }
}

pub fn assert_ne<T: Eq + Show>(a: T, b: T) {
    if a == b {
        panic("assertion failed: both values are {a.show_nested()}")
    }
}

pub fn min<T: Ord>(a: T, b: T) -> T {
    if b < a { b } else { a }
}

pub fn max<T: Ord>(a: T, b: T) -> T {
    if b > a { b } else { a }
}

pub fn todo() -> Never {
    panic("not yet implemented")
}

// ---------------------------------------------------------------- traits

pub trait Show {
    fn show(self) -> Str
    /// How the value looks inside a collection (strings get quotes).
    fn show_nested(self) -> Str { self.show() }
}

pub trait Eq {
    fn eq(self, other: Self) -> Bool
    fn ne(self, other: Self) -> Bool { !self.eq(other) }
}

pub enum Ordering {
    Less
    Equal
    Greater
}

pub trait Ord: Eq {
    fn cmp(self, other: Self) -> Ordering
    fn lt(self, other: Self) -> Bool {
        match self.cmp(other) {
            Ordering.Less -> true
            _ -> false
        }
    }
    fn le(self, other: Self) -> Bool {
        match self.cmp(other) {
            Ordering.Greater -> false
            _ -> true
        }
    }
    fn gt(self, other: Self) -> Bool {
        match self.cmp(other) {
            Ordering.Greater -> true
            _ -> false
        }
    }
    fn ge(self, other: Self) -> Bool {
        match self.cmp(other) {
            Ordering.Less -> false
            _ -> true
        }
    }
}

pub trait Hash {
    fn hash(self) -> Int
}

pub trait From<T> {
    fn from(value: T) -> Self
}

pub trait Error: Show {
    fn source(self) -> Option<dyn Error> { None }
}

/// Values that can be sent between workers; messages are deep-copied.
pub trait Transfer {
    fn __enc(self, b: StrBuilder)
    fn __dec(r: __Reader) -> Self
}

/// Reads the message encoding used by `Transfer`.
pub struct __Reader {
    s: Str
    var pos: Int
}

impl __Reader {
    pub fn i64(self) -> I64 {
        let start = self.pos
        while __str_byte(self.s, self.pos) != 59 { self.pos += 1 }
        let t = __str_slice(self.s, start, self.pos)
        self.pos += 1
        t.parse_i64().expect("malformed worker message")
    }
    pub fn int(self) -> Int { __cast<I64, Int>(self.i64()) }
    pub fn str(self) -> Str {
        let n = self.int()
        let v = __str_slice(self.s, self.pos, self.pos + n)
        self.pos += n
        v
    }
}

pub fn __enc_int(b: StrBuilder, v: I64) {
    b.push(v.show())
    b.push_byte(59)
}

pub fn __tdec<T: Transfer>(r: __Reader) -> T { T.__dec(r) }

pub fn __transfer_encode<T: Transfer>(v: T) -> Str {
    let b = StrBuilder.new()
    v.__enc(b)
    b.to_str()
}

pub fn __transfer_decode<T: Transfer>(s: Str) -> T {
    let r = __Reader { s, pos: 0 }
    T.__dec(r)
}

pub trait Add {
    fn add(self, other: Self) -> Self
}
pub trait Sub {
    fn sub(self, other: Self) -> Self
}
pub trait Mul {
    fn mul(self, other: Self) -> Self
}
pub trait Div {
    fn div(self, other: Self) -> Self
}
pub trait Rem {
    fn rem(self, other: Self) -> Self
}
pub trait Neg {
    fn neg(self) -> Self
}
pub trait Not {
    fn not(self) -> Self
}

pub trait Index<I, O> {
    fn index(self, i: I) -> O
    fn set_index(self, i: I, v: O) { panic("this type does not support index assignment") }
}

pub trait Iterator {
    type Item
    fn next(self) -> Option<Self.Item>

    fn map<B>(self, f: fn(Self.Item) -> B) -> Mapped<Self, Self.Item, B> {
        Mapped { it: self, f }
    }
    fn filter(self, f: fn(Self.Item) -> Bool) -> Filtered<Self, Self.Item> {
        Filtered { it: self, f }
    }
    fn enumerate(self) -> Enumerated<Self, Self.Item> {
        Enumerated { it: self, i: 0 }
    }
    fn take(self, n: Int) -> Taken<Self, Self.Item> {
        Taken { it: self, n }
    }
    fn skip(self, n: Int) -> Skipped<Self, Self.Item> {
        Skipped { it: self, n }
    }
    fn zip<J: Iterator>(self, other: J) -> Zipped<Self, J, Self.Item, J.Item> {
        Zipped { a: self, b: other }
    }
    fn chain(self, other: Self) -> Chained<Self, Self.Item> {
        Chained { a: self, b: other, first: true }
    }
    fn collect(self) -> List<Self.Item> {
        let out: List<Self.Item> = List.new()
        self.fold(out, |o, x| {
            o.push(x)
            o
        })
    }
    fn to_list(self) -> List<Self.Item> { self.collect() }
    fn count(self) -> Int {
        self.fold(0, |n, _x| n + 1)
    }
    fn fold<B>(self, init: B, f: fn(B, Self.Item) -> B) -> B {
        var acc = init
        while let Some(x) = self.next() {
            acc = f(acc, x)
        }
        acc
    }
    fn for_each(self, f: fn(Self.Item)) {
        self.fold((), |_u, x| f(x))
    }
    fn any(self, f: fn(Self.Item) -> Bool) -> Bool {
        while let Some(x) = self.next() {
            if f(x) { return true }
        }
        false
    }
    fn all(self, f: fn(Self.Item) -> Bool) -> Bool {
        while let Some(x) = self.next() {
            if !f(x) { return false }
        }
        true
    }
    fn find(self, f: fn(Self.Item) -> Bool) -> Option<Self.Item> {
        while let Some(x) = self.next() {
            if f(x) { return Some(x) }
        }
        None
    }
    fn position(self, f: fn(Self.Item) -> Bool) -> Option<Int> {
        var i = 0
        while let Some(x) = self.next() {
            if f(x) { return Some(i) }
            i += 1
        }
        None
    }
    fn last(self) -> Option<Self.Item> {
        var out = None
        while let Some(x) = self.next() {
            out = Some(x)
        }
        out
    }
    fn min(self) -> Option<Self.Item> {
        var best = self.next()?
        while let Some(x) = self.next() {
            if x < best { best = x }
        }
        Some(best)
    }
    fn max(self) -> Option<Self.Item> {
        var best = self.next()?
        while let Some(x) = self.next() {
            if x > best { best = x }
        }
        Some(best)
    }
}

/// Types that can be used in `for x in value`.
pub trait Iterable {
    type Iter
    fn iter(self) -> Self.Iter
}

impl<I: Iterator> Iterable for I {
    type Iter = I
    fn iter(self) -> I { self }
}

pub struct Mapped<I, A, B> {
    it: I
    f: fn(A) -> B
}

impl<I: Iterator, A, B> Iterator for Mapped<I, A, B> {
    type Item = B
    fn next(self) -> Option<B> {
        match self.it.next() {
            Some(x) -> Some((self.f)(x))
            None -> None
        }
    }
    fn fold<C>(self, init: C, f: fn(C, B) -> C) -> C {
        let g = self.f
        self.it.fold(init, |acc: C, x: A| -> C { f(acc, g(x)) })
    }
}

pub struct Filtered<I, A> {
    it: I
    f: fn(A) -> Bool
}

impl<I: Iterator, A> Iterator for Filtered<I, A> {
    type Item = A
    fn next(self) -> Option<A> {
        loop {
            match self.it.next() {
                Some(x) -> if (self.f)(x) { return Some(x) }
                None -> return None
            }
        }
    }
    fn fold<B>(self, init: B, f: fn(B, A) -> B) -> B {
        let p = self.f
        self.it.fold(init, |acc: B, x: A| -> B { if p(x) { f(acc, x) } else { acc } })
    }
}

pub struct Enumerated<I, A> {
    it: I
    var i: Int
}

impl<I: Iterator, A> Iterator for Enumerated<I, A> {
    type Item = (Int, A)
    fn next(self) -> Option<(Int, A)> {
        match self.it.next() {
            Some(x) -> {
                let i = self.i
                self.i = i + 1
                Some((i, x))
            }
            None -> None
        }
    }
}

pub struct Taken<I, A> {
    it: I
    var n: Int
}

impl<I: Iterator, A> Iterator for Taken<I, A> {
    type Item = A
    fn next(self) -> Option<A> {
        if self.n <= 0 { return None }
        self.n -= 1
        self.it.next()
    }
}

pub struct Skipped<I, A> {
    it: I
    var n: Int
}

impl<I: Iterator, A> Iterator for Skipped<I, A> {
    type Item = A
    fn next(self) -> Option<A> {
        while self.n > 0 {
            self.n -= 1
            if self.it.next().is_none() { return None }
        }
        self.it.next()
    }
}

pub struct Zipped<I, J, A, B> {
    a: I
    b: J
}

impl<I: Iterator, J: Iterator, A, B> Iterator for Zipped<I, J, A, B> {
    type Item = (A, B)
    fn next(self) -> Option<(A, B)> {
        let x = self.a.next()?
        let y = self.b.next()?
        Some((x, y))
    }
}

pub struct Chained<I, A> {
    a: I
    b: I
    var first: Bool
}

impl<I: Iterator, A> Iterator for Chained<I, A> {
    type Item = A
    fn next(self) -> Option<A> {
        if self.first {
            match self.a.next() {
                Some(x) -> return Some(x)
                None -> self.first = false
            }
        }
        self.b.next()
    }
}

// ---------------------------------------------------------------- Option

pub enum Option<T> {
    Some(T)
    None
}

impl<T> Option<T> {
    pub fn is_some(self) -> Bool {
        match self {
            Some(_) -> true
            None -> false
        }
    }
    pub fn is_none(self) -> Bool { !self.is_some() }
    pub fn unwrap(self) -> T {
        match self {
            Some(v) -> v
            None -> panic("called `unwrap` on `None`")
        }
    }
    pub fn expect(self, msg: Str) -> T {
        match self {
            Some(v) -> v
            None -> panic(msg)
        }
    }
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(v) -> v
            None -> default
        }
    }
    pub fn unwrap_or_else(self, f: fn() -> T) -> T {
        match self {
            Some(v) -> v
            None -> f()
        }
    }
    pub fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Some(v) -> Some(f(v))
            None -> None
        }
    }
    pub fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Some(v) -> f(v)
            None -> None
        }
    }
    pub fn or(self, other: Option<T>) -> Option<T> {
        match self {
            Some(v) -> Some(v)
            None -> other
        }
    }
    pub fn or_else(self, f: fn() -> Option<T>) -> Option<T> {
        match self {
            Some(v) -> Some(v)
            None -> f()
        }
    }
    pub fn filter(self, f: fn(T) -> Bool) -> Option<T> {
        match self {
            Some(v) -> if f(v) { Some(v) } else { None }
            None -> None
        }
    }
    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Some(v) -> Ok(v)
            None -> Err(err)
        }
    }
    pub fn ok_or_else<E>(self, f: fn() -> E) -> Result<T, E> {
        match self {
            Some(v) -> Ok(v)
            None -> Err(f())
        }
    }
    pub fn to_list(self) -> List<T> {
        match self {
            Some(v) -> [v]
            None -> []
        }
    }
}

impl<T: Show> Show for Option<T> {
    fn show(self) -> Str {
        match self {
            Some(v) -> "Some({v.show_nested()})"
            None -> "None"
        }
    }
}

impl<T: Eq> Eq for Option<T> {
    fn eq(self, other: Option<T>) -> Bool {
        match (self, other) {
            (Some(a), Some(b)) -> a == b
            (None, None) -> true
            _ -> false
        }
    }
}

impl<T: Ord> Ord for Option<T> {
    fn cmp(self, other: Option<T>) -> Ordering {
        match (self, other) {
            (Some(a), Some(b)) -> a.cmp(b)
            (None, None) -> Ordering.Equal
            (None, _) -> Ordering.Less
            _ -> Ordering.Greater
        }
    }
}

impl<T: Hash> Hash for Option<T> {
    fn hash(self) -> Int {
        match self {
            Some(v) -> v.hash().wrapping_mul(31).wrapping_add(1)
            None -> 0
        }
    }
}

// ---------------------------------------------------------------- Result

pub enum Result<T, E> {
    Ok(T)
    Err(E)
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> Bool {
        match self {
            Ok(_) -> true
            Err(_) -> false
        }
    }
    pub fn is_err(self) -> Bool { !self.is_ok() }
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(v) -> Some(v)
            Err(_) -> None
        }
    }
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) -> None
            Err(e) -> Some(e)
        }
    }
    pub fn unwrap(self) -> T {
        match self {
            Ok(v) -> v
            Err(e) -> panic("called `unwrap` on `Err`: {e}")
        }
    }
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(_) -> panic("called `unwrap_err` on `Ok`")
            Err(e) -> e
        }
    }
    pub fn expect(self, msg: Str) -> T {
        match self {
            Ok(v) -> v
            Err(e) -> panic("{msg}: {e}")
        }
    }
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(v) -> v
            Err(_) -> default
        }
    }
    pub fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        match self {
            Ok(v) -> v
            Err(e) -> f(e)
        }
    }
    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(v) -> Ok(f(v))
            Err(e) -> Err(e)
        }
    }
    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Ok(v) -> Ok(v)
            Err(e) -> Err(f(e))
        }
    }
    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(v) -> f(v)
            Err(e) -> Err(e)
        }
    }
}

impl<T: Show, E: Show> Show for Result<T, E> {
    fn show(self) -> Str {
        match self {
            Ok(v) -> "Ok({v.show_nested()})"
            Err(e) -> "Err({e.show_nested()})"
        }
    }
}

impl<T: Eq, E: Eq> Eq for Result<T, E> {
    fn eq(self, other: Result<T, E>) -> Bool {
        match (self, other) {
            (Ok(a), Ok(b)) -> a == b
            (Err(a), Err(b)) -> a == b
            _ -> false
        }
    }
}

// ---------------------------------------------------------------- Ordering

impl Ordering {
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering.Less -> Ordering.Greater
            Ordering.Equal -> Ordering.Equal
            Ordering.Greater -> Ordering.Less
        }
    }
    pub fn is_lt(self) -> Bool { self.to_int() < 0 }
    pub fn is_eq(self) -> Bool { self.to_int() == 0 }
    pub fn is_gt(self) -> Bool { self.to_int() > 0 }
    pub fn then(self, other: Ordering) -> Ordering {
        match self {
            Ordering.Equal -> other
            o -> o
        }
    }
    pub fn to_int(self) -> Int {
        match self {
            Ordering.Less -> -1
            Ordering.Equal -> 0
            Ordering.Greater -> 1
        }
    }
}

impl Show for Ordering {
    fn show(self) -> Str {
        match self {
            Ordering.Less -> "Less"
            Ordering.Equal -> "Equal"
            Ordering.Greater -> "Greater"
        }
    }
}

impl Eq for Ordering {
    fn eq(self, other: Ordering) -> Bool { self.to_int() == other.to_int() }
}

impl Ord for Ordering {
    fn cmp(self, other: Ordering) -> Ordering { self.to_int().cmp(other.to_int()) }
}

impl Hash for Ordering {
    fn hash(self) -> Int { self.to_int() }
}

// ---------------------------------------------------------------- Unit, Bool

impl Show for () {
    fn show(self) -> Str { "()" }
}
impl Eq for () {
    fn eq(self, other: ()) -> Bool { true }
}
impl Ord for () {
    fn cmp(self, other: ()) -> Ordering { Ordering.Equal }
}
impl Hash for () {
    fn hash(self) -> Int { 0 }
}

impl Show for Bool {
    fn show(self) -> Str { if self { "true" } else { "false" } }
}
impl Eq for Bool {
    fn eq(self, other: Bool) -> Bool { self == other }
}
impl Ord for Bool {
    fn cmp(self, other: Bool) -> Ordering {
        if self == other { Ordering.Equal } else if self { Ordering.Greater } else { Ordering.Less }
    }
}
impl Hash for Bool {
    fn hash(self) -> Int { if self { 1 } else { 0 } }
}
impl Not for Bool {
    fn not(self) -> Bool { !self }
}

// ---------------------------------------------------------------- tuples

impl<A: Show, B: Show> Show for (A, B) {
    fn show(self) -> Str { "({self.0.show_nested()}, {self.1.show_nested()})" }
}
impl<A: Show, B: Show, C: Show> Show for (A, B, C) {
    fn show(self) -> Str { "({self.0.show_nested()}, {self.1.show_nested()}, {self.2.show_nested()})" }
}
impl<A: Show, B: Show, C: Show, D: Show> Show for (A, B, C, D) {
    fn show(self) -> Str { "({self.0.show_nested()}, {self.1.show_nested()}, {self.2.show_nested()}, {self.3.show_nested()})" }
}
impl<A: Eq, B: Eq> Eq for (A, B) {
    fn eq(self, other: (A, B)) -> Bool { self.0 == other.0 && self.1 == other.1 }
}
impl<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {
    fn eq(self, other: (A, B, C)) -> Bool { self.0 == other.0 && self.1 == other.1 && self.2 == other.2 }
}
impl<A: Eq, B: Eq, C: Eq, D: Eq> Eq for (A, B, C, D) {
    fn eq(self, other: (A, B, C, D)) -> Bool { self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3 }
}
impl<A: Ord, B: Ord> Ord for (A, B) {
    fn cmp(self, other: (A, B)) -> Ordering { self.0.cmp(other.0).then(self.1.cmp(other.1)) }
}
impl<A: Ord, B: Ord, C: Ord> Ord for (A, B, C) {
    fn cmp(self, other: (A, B, C)) -> Ordering { self.0.cmp(other.0).then(self.1.cmp(other.1)).then(self.2.cmp(other.2)) }
}
impl<A: Ord, B: Ord, C: Ord, D: Ord> Ord for (A, B, C, D) {
    fn cmp(self, other: (A, B, C, D)) -> Ordering {
        self.0.cmp(other.0).then(self.1.cmp(other.1)).then(self.2.cmp(other.2)).then(self.3.cmp(other.3))
    }
}
impl<A: Hash, B: Hash> Hash for (A, B) {
    fn hash(self) -> Int { __hash_mix(self.0.hash(), self.1.hash()) }
}
impl<A: Hash, B: Hash, C: Hash> Hash for (A, B, C) {
    fn hash(self) -> Int { __hash_mix(__hash_mix(self.0.hash(), self.1.hash()), self.2.hash()) }
}
impl<A: Hash, B: Hash, C: Hash, D: Hash> Hash for (A, B, C, D) {
    fn hash(self) -> Int { __hash_mix(__hash_mix(__hash_mix(self.0.hash(), self.1.hash()), self.2.hash()), self.3.hash()) }
}

pub fn __hash_mix(h: Int, x: Int) -> Int {
    (h ^ x).wrapping_mul(16777619).wrapping_add(x >> 7)
}

// ---------------------------------------------------------------- StrBuilder

/// A growable buffer for building strings efficiently.
pub struct StrBuilder {
    var buf: Array<U8>
    var len: Int
}

impl StrBuilder {
    pub fn new() -> StrBuilder { StrBuilder { buf: __array_new(16), len: 0 } }
    fn reserve(self, extra: Int) {
        let need = self.len + extra
        let cap = __array_len(self.buf)
        if need > cap {
            var n = cap * 2
            if n < need { n = need }
            let nb: Array<U8> = __array_new(n)
            __array_copy(nb, 0, self.buf, 0, self.len)
            self.buf = nb
        }
    }
    pub fn push_byte(self, b: Int) {
        self.reserve(1)
        __bytes_set(self.buf, self.len, b)
        self.len += 1
    }
    pub fn push(self, s: Str) {
        let n = __str_len(s)
        self.reserve(n)
        __bytes_copy_str(self.buf, self.len, s, 0, n)
        self.len += n
    }
    pub fn push_char(self, c: Char) {
        let u = c.to_u32().wrap_to_int()
        if u < 0x80 {
            self.push_byte(u)
        } else if u < 0x800 {
            self.push_byte(0xC0 | (u >> 6))
            self.push_byte(0x80 | (u & 0x3F))
        } else if u < 0x10000 {
            self.push_byte(0xE0 | (u >> 12))
            self.push_byte(0x80 | ((u >> 6) & 0x3F))
            self.push_byte(0x80 | (u & 0x3F))
        } else {
            self.push_byte(0xF0 | (u >> 18))
            self.push_byte(0x80 | ((u >> 12) & 0x3F))
            self.push_byte(0x80 | ((u >> 6) & 0x3F))
            self.push_byte(0x80 | (u & 0x3F))
        }
    }
    pub fn len(self) -> Int { self.len }
    pub fn to_str(self) -> Str { __str_from_bytes(self.buf, self.len) }
}

impl Show for StrBuilder {
    fn show(self) -> Str { self.to_str() }
}

// ---------------------------------------------------------------- Str

/// A position in a string; only valid for the string that produced it.
pub struct StrIndex {
    pos: Int
}

impl Eq for StrIndex {
    fn eq(self, other: StrIndex) -> Bool { self.pos == other.pos }
}
impl Ord for StrIndex {
    fn cmp(self, other: StrIndex) -> Ordering { self.pos.cmp(other.pos) }
}
impl Show for StrIndex {
    fn show(self) -> Str { "StrIndex({self.pos})" }
}

fn __utf8_width(b: Int) -> Int {
    if b < 0x80 { 1 } else if b < 0xE0 { 2 } else if b < 0xF0 { 3 } else { 4 }
}

fn __is_space_byte(b: Int) -> Bool {
    b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

impl Str {
    pub fn utf8_len(self) -> Int { __str_len(self) }
    pub fn is_empty(self) -> Bool { __str_len(self) == 0 }
    pub fn chars(self) -> Chars { Chars { s: self, pos: 0 } }
    pub fn graphemes(self) -> Graphemes { Graphemes { chars: self.chars(), pending: None } }
    pub fn start(self) -> StrIndex { StrIndex { pos: 0 } }
    pub fn end(self) -> StrIndex { StrIndex { pos: __str_len(self) } }

    fn find_from(self, sub: Str, from: Int) -> Int {
        let n = __str_len(self)
        let m = __str_len(sub)
        var i = from
        while i + m <= n {
            var j = 0
            while j < m && __str_byte(self, i + j) == __str_byte(sub, j) {
                j += 1
            }
            if j == m { return i }
            i += 1
        }
        -1
    }

    pub fn find(self, sub: Str) -> Option<StrIndex> {
        let i = self.find_from(sub, 0)
        if i < 0 { None } else { Some(StrIndex { pos: i }) }
    }
    pub fn rfind(self, sub: Str) -> Option<StrIndex> {
        var i = __str_len(self) - __str_len(sub)
        while i >= 0 {
            if self.find_from(sub, i) == i { return Some(StrIndex { pos: i }) }
            i -= 1
        }
        None
    }
    pub fn contains(self, sub: Str) -> Bool { self.find_from(sub, 0) >= 0 }
    pub fn starts_with(self, p: Str) -> Bool {
        let m = __str_len(p)
        m <= __str_len(self) && __str_eq(__str_slice(self, 0, m), p)
    }
    pub fn ends_with(self, p: Str) -> Bool {
        let n = __str_len(self)
        let m = __str_len(p)
        m <= n && __str_eq(__str_slice(self, n - m, n), p)
    }
    pub fn slice(self, a: StrIndex, b: StrIndex) -> Str {
        let n = __str_len(self)
        if a.pos < 0 || b.pos > n || a.pos > b.pos { panic("string index out of range") }
        __str_slice(self, a.pos, b.pos)
    }
    pub fn slice_from(self, a: StrIndex) -> Str { self.slice(a, self.end()) }
    pub fn slice_to(self, b: StrIndex) -> Str { self.slice(self.start(), b) }
    /// The index just past the character at `i`, if any.
    pub fn next_index(self, i: StrIndex) -> Option<StrIndex> {
        if i.pos >= __str_len(self) { return None }
        Some(StrIndex { pos: i.pos + __utf8_width(__str_byte(self, i.pos)) })
    }
    /// Index `n` characters after `i`, if within the string.
    pub fn advance(self, i: StrIndex, n: Int) -> Option<StrIndex> {
        var cur = i
        var k = 0
        while k < n {
            cur = self.next_index(cur)?
            k += 1
        }
        Some(cur)
    }
    pub fn split_once(self, sep: Str) -> Option<(Str, Str)> {
        let i = self.find_from(sep, 0)
        if i < 0 { return None }
        Some((__str_slice(self, 0, i), __str_slice(self, i + __str_len(sep), __str_len(self))))
    }
    pub fn split(self, sep: Str) -> List<Str> {
        let out: List<Str> = List.new()
        let n = __str_len(self)
        let m = __str_len(sep)
        if m == 0 {
            for c in self.chars() { out.push(c.to_str()) }
            return out
        }
        var start = 0
        loop {
            let i = self.find_from(sep, start)
            if i < 0 {
                out.push(__str_slice(self, start, n))
                return out
            }
            out.push(__str_slice(self, start, i))
            start = i + m
        }
    }
    pub fn split_whitespace(self) -> List<Str> {
        let out: List<Str> = List.new()
        let n = __str_len(self)
        var i = 0
        while i < n {
            while i < n && __is_space_byte(__str_byte(self, i)) { i += 1 }
            let s = i
            while i < n && !__is_space_byte(__str_byte(self, i)) { i += 1 }
            if i > s { out.push(__str_slice(self, s, i)) }
        }
        out
    }
    pub fn lines(self) -> List<Str> {
        let out: List<Str> = List.new()
        let n = __str_len(self)
        var start = 0
        var i = 0
        while i < n {
            if __str_byte(self, i) == 10 {
                var e = i
                if e > start && __str_byte(self, e - 1) == 13 { e -= 1 }
                out.push(__str_slice(self, start, e))
                start = i + 1
            }
            i += 1
        }
        if start < n { out.push(__str_slice(self, start, n)) }
        out
    }
    pub fn trim(self) -> Str { self.trim_start().trim_end() }
    pub fn trim_start(self) -> Str {
        let n = __str_len(self)
        var i = 0
        while i < n && __is_space_byte(__str_byte(self, i)) { i += 1 }
        __str_slice(self, i, n)
    }
    pub fn trim_end(self) -> Str {
        var n = __str_len(self)
        while n > 0 && __is_space_byte(__str_byte(self, n - 1)) { n -= 1 }
        __str_slice(self, 0, n)
    }
    pub fn to_upper(self) -> Str {
        let b = StrBuilder.new()
        for c in self.chars() { b.push_char(c.to_upper()) }
        b.to_str()
    }
    pub fn to_lower(self) -> Str {
        let b = StrBuilder.new()
        for c in self.chars() { b.push_char(c.to_lower()) }
        b.to_str()
    }
    pub fn replace(self, from: Str, to: Str) -> Str {
        if __str_len(from) == 0 { return self }
        let b = StrBuilder.new()
        var start = 0
        loop {
            let i = self.find_from(from, start)
            if i < 0 {
                b.push(__str_slice(self, start, __str_len(self)))
                return b.to_str()
            }
            b.push(__str_slice(self, start, i))
            b.push(to)
            start = i + __str_len(from)
        }
    }
    pub fn repeat(self, n: Int) -> Str {
        let b = StrBuilder.new()
        var i = 0
        while i < n {
            b.push(self)
            i += 1
        }
        b.to_str()
    }
    pub fn parse_i64(self) -> Option<I64> {
        let s = self.trim()
        let n = __str_len(s)
        if n == 0 { return None }
        var i = 0
        var neg = false
        let c0 = __str_byte(s, 0)
        if c0 == 45 || c0 == 43 {
            neg = c0 == 45
            i = 1
            if n == 1 { return None }
        }
        var acc: I64 = 0
        while i < n {
            let d = __str_byte(s, i) - 48
            if d < 0 || d > 9 { return None }
            let m = acc.checked_mul(10)?
            acc = if neg { m.checked_sub(d)? } else { m.checked_add(d)? }
            i += 1
        }
        Some(acc)
    }
    pub fn parse_int(self) -> Option<Int> { self.parse_i64()?.to_int() }
    pub fn parse_float(self) -> Option<Float> {
        let s = self.trim()
        if s == "NaN" { return Some(0.0 / 0.0) }
        let v = __parse_f64(s)
        if v.is_nan() { None } else { Some(v) }
    }
    pub fn to_bytes(self) -> List<U8> {
        let n = __str_len(self)
        let out: List<U8> = List.with_capacity(n)
        var i = 0
        while i < n {
            out.push(__str_byte(self, i).wrap_to_u8())
            i += 1
        }
        out
    }
    pub fn from_chars(cs: List<Char>) -> Str {
        let b = StrBuilder.new()
        for c in cs { b.push_char(c) }
        b.to_str()
    }
    /// Builds a string from UTF-8 bytes; None if the bytes are not valid UTF-8.
    pub fn from_utf8(bytes: List<U8>) -> Option<Str> {
        let n = bytes.len()
        let a: Array<U8> = __array_new(n)
        var i = 0
        while i < n {
            __array_set(a, i, bytes[i])
            i += 1
        }
        let s = __str_from_bytes(a, n)
        if __utf8_valid(s) { Some(s) } else { None }
    }
}

fn __utf8_valid(s: Str) -> Bool {
    let n = __str_len(s)
    var i = 0
    while i < n {
        let b = __str_byte(s, i)
        let w = if b < 0x80 { 1 } else if b >= 0xC2 && b < 0xE0 { 2 } else if b >= 0xE0 && b < 0xF0 { 3 } else if b >= 0xF0 && b < 0xF5 { 4 } else { 0 }
        if w == 0 || w > n - i { return false }
        if w >= 3 {
            let second = __str_byte(s, i + 1)
            if (b == 0xE0 && second < 0xA0) || (b == 0xED && second >= 0xA0) ||
                (b == 0xF0 && second < 0x90) || (b == 0xF4 && second >= 0x90) {
                return false
            }
        }
        var k = 1
        while k < w {
            if (__str_byte(s, i + k) & 0xC0) != 0x80 { return false }
            k += 1
        }
        i += w
    }
    true
}

pub struct Chars {
    s: Str
    var pos: Int
}

impl Iterator for Chars {
    type Item = Char
    fn next(self) -> Option<Char> {
        let s = self.s
        let n = __str_len(s)
        let i = self.pos
        if i >= n { return None }
        let b = __str_byte(s, i)
        var u = 0
        var w = 1
        if b < 0x80 {
            u = b
        } else if b < 0xE0 {
            u = ((b & 0x1F) << 6) | (__str_byte(s, i + 1) & 0x3F)
            w = 2
        } else if b < 0xF0 {
            u = ((b & 0x0F) << 12) | ((__str_byte(s, i + 1) & 0x3F) << 6) | (__str_byte(s, i + 2) & 0x3F)
            w = 3
        } else {
            u = ((b & 0x07) << 18) | ((__str_byte(s, i + 1) & 0x3F) << 12) | ((__str_byte(s, i + 2) & 0x3F) << 6) | (__str_byte(s, i + 3) & 0x3F)
            w = 4
        }
        self.pos = i + w
        Some(__cast<Int, Char>(u))
    }
}

fn __is_combining(c: Char) -> Bool {
    let u = c.to_u32()
    (u >= 0x300 && u <= 0x36F) || (u >= 0x1AB0 && u <= 0x1AFF) || (u >= 0x20D0 && u <= 0x20FF) ||
        (u >= 0xFE00 && u <= 0xFE0F) || (u >= 0x1F3FB && u <= 0x1F3FF) || u == 0x200D ||
        (u >= 0xE0100 && u <= 0xE01EF)
}

/// Approximate extended grapheme clusters: a base character followed by
/// combining marks, variation selectors, skin tones and ZWJ sequences.
pub struct Graphemes {
    chars: Chars
    var pending: Option<Char>
}

impl Iterator for Graphemes {
    type Item = Str
    fn next(self) -> Option<Str> {
        let first = match self.pending {
            Some(c) -> c
            None -> self.chars.next()?
        }
        self.pending = None
        let b = StrBuilder.new()
        b.push_char(first)
        var joined = false
        loop {
            match self.chars.next() {
                Some(c) -> {
                    if joined || __is_combining(c) {
                        b.push_char(c)
                        joined = c.to_u32() == 0x200D
                    } else {
                        self.pending = Some(c)
                        break
                    }
                }
                None -> break
            }
        }
        Some(b.to_str())
    }
}

fn __quote(s: Str, q: Int) -> Str {
    let b = StrBuilder.new()
    b.push_byte(q)
    let n = __str_len(s)
    var i = 0
    while i < n {
        let c = __str_byte(s, i)
        if c == q || c == 92 {
            b.push_byte(92)
            b.push_byte(c)
        } else if c == 10 {
            b.push("\\n")
        } else if c == 9 {
            b.push("\\t")
        } else if c == 13 {
            b.push("\\r")
        } else {
            b.push_byte(c)
        }
        i += 1
    }
    b.push_byte(q)
    b.to_str()
}

impl Show for Str {
    fn show(self) -> Str { self }
    fn show_nested(self) -> Str { __quote(self, 34) }
}
impl Eq for Str {
    fn eq(self, other: Str) -> Bool { __str_eq(self, other) }
}
impl Ord for Str {
    fn cmp(self, other: Str) -> Ordering {
        let c = __str_cmp(self, other)
        if c < 0 { Ordering.Less } else if c > 0 { Ordering.Greater } else { Ordering.Equal }
    }
}
impl Hash for Str {
    fn hash(self) -> Int {
        var h = -2128831035
        let n = __str_len(self)
        var i = 0
        while i < n {
            h = (h ^ __str_byte(self, i)).wrapping_mul(16777619)
            i += 1
        }
        h
    }
}
impl Add for Str {
    fn add(self, other: Str) -> Str { __str_concat(self, other) }
}
impl Error for Str {}

// ---------------------------------------------------------------- Char

impl Char {
    pub fn to_u32(self) -> U32 { __cast<Char, U32>(self) }
    pub fn from_u32(n: U32) -> Option<Char> {
        if n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF) { None } else { Some(__cast<U32, Char>(n)) }
    }
    pub fn is_digit(self) -> Bool { self >= '0' && self <= '9' }
    pub fn is_alpha(self) -> Bool { (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z') || self.to_u32() > 0x7F && !self.is_whitespace() }
    pub fn is_alphanumeric(self) -> Bool { self.is_alpha() || self.is_digit() }
    pub fn is_whitespace(self) -> Bool {
        self == ' ' || self == '\n' || self == '\t' || self == '\r' || self.to_u32() == 0x0B || self.to_u32() == 0x0C || self.to_u32() == 0xA0 || self.to_u32() == 0x3000
    }
    pub fn is_upper(self) -> Bool { self >= 'A' && self <= 'Z' }
    pub fn is_lower(self) -> Bool { self >= 'a' && self <= 'z' }
    pub fn is_ascii(self) -> Bool { self.to_u32() < 0x80 }
    pub fn to_upper(self) -> Char {
        if self.is_lower() { __cast<U32, Char>(self.to_u32() - 32) } else { self }
    }
    pub fn to_lower(self) -> Char {
        if self.is_upper() { __cast<U32, Char>(self.to_u32() + 32) } else { self }
    }
    pub fn to_digit(self, radix: Int) -> Option<Int> {
        let u = self.to_u32().wrap_to_int()
        let d = if u >= 48 && u <= 57 { u - 48 } else if u >= 97 && u <= 122 { u - 87 } else if u >= 65 && u <= 90 { u - 55 } else { 99 }
        if d < radix { Some(d) } else { None }
    }
    pub fn to_str(self) -> Str {
        let b = StrBuilder.new()
        b.push_char(self)
        b.to_str()
    }
}

impl Show for Char {
    fn show(self) -> Str { self.to_str() }
    fn show_nested(self) -> Str { __quote(self.to_str(), 39) }
}
impl Eq for Char {
    fn eq(self, other: Char) -> Bool { self == other }
}
impl Ord for Char {
    fn cmp(self, other: Char) -> Ordering {
        if self < other { Ordering.Less } else if self > other { Ordering.Greater } else { Ordering.Equal }
    }
}
impl Hash for Char {
    fn hash(self) -> Int { self.to_u32().wrap_to_int() }
}

// ---------------------------------------------------------------- number formatting

fn __fmt_u64(v: U64) -> Str {
    if v == 0 { return "0" }
    let buf: Array<U8> = __array_new(20)
    var i = 20
    var x = v
    while x > 0 {
        i -= 1
        __bytes_set(buf, i, (x % 10).wrap_to_int() + 48)
        x = x / 10
    }
    let out: Array<U8> = __array_new(20 - i)
    __array_copy(out, 0, buf, i, 20 - i)
    __str_from_bytes(out, 20 - i)
}

fn __fmt_i64(v: I64) -> Str {
    if v >= 0 { return __fmt_u64(v.wrap_to_u64()) }
    if v == -9223372036854775808 { return "-9223372036854775808" }
    "-" + __fmt_u64((0 - v).wrap_to_u64())
}

// ---------------------------------------------------------------- List

/// A growable array.
pub struct List<T> {
    var len: Int
    var data: Array<T>
}

pub struct ListIter<T> {
    list: List<T>
    var i: Int
}

impl<T> Iterator for ListIter<T> {
    type Item = T
    fn next(self) -> Option<T> {
        let i = self.i
        if i >= self.list.len { return None }
        self.i = i + 1
        Some(__array_get(self.list.data, i))
    }
    fn fold<B>(self, init: B, f: fn(B, T) -> B) -> B {
        var acc = init
        while self.i < self.list.len {
            let x = __array_get(self.list.data, self.i)
            self.i += 1
            acc = f(acc, x)
        }
        acc
    }
}

impl<T> Iterable for List<T> {
    type Iter = ListIter<T>
    fn iter(self) -> ListIter<T> { ListIter { list: self, i: 0 } }
}

pub fn __list_oob(i: Int, len: Int) -> Never {
    panic("index {i} out of bounds for list of length {len}")
}

impl<T> List<T> {
    pub fn new() -> List<T> { List { len: 0, data: __array_new(0) } }
    pub fn with_capacity(n: Int) -> List<T> { List { len: 0, data: __array_new(n) } }
    pub fn filled(n: Int, v: T) -> List<T> {
        let l: List<T> = List.with_capacity(n)
        __array_fill(l.data, 0, v, n)
        l.len = n
        l
    }
    pub fn len(self) -> Int { self.len }
    pub fn is_empty(self) -> Bool { self.len == 0 }
    fn check(self, i: Int) {
        // one unsigned comparison covers i < 0; the message is built out of line so this stays inlinable
        if __cast<Int, U32>(i) >= __cast<Int, U32>(self.len) { __list_oob(i, self.len) }
    }
    fn reserve(self, need: Int) {
        let cap = __array_len(self.data)
        if need > cap {
            var n = cap * 2
            if n < 4 { n = 4 }
            if n < need { n = need }
            let nd: Array<T> = __array_new(n)
            __array_copy(nd, 0, self.data, 0, self.len)
            self.data = nd
        }
    }
    pub fn push(self, v: T) {
        self.reserve(self.len + 1)
        __array_set(self.data, self.len, v)
        self.len += 1
    }
    pub fn pop(self) -> Option<T> {
        if self.len == 0 { return None }
        self.len -= 1
        Some(__array_get(self.data, self.len))
    }
    pub fn get(self, i: Int) -> Option<T> {
        if i < 0 || i >= self.len { None } else { Some(__array_get(self.data, i)) }
    }
    pub fn set(self, i: Int, v: T) {
        self.check(i)
        __array_set(self.data, i, v)
    }
    pub fn first(self) -> Option<T> { self.get(0) }
    pub fn last(self) -> Option<T> { self.get(self.len - 1) }
    pub fn insert(self, i: Int, v: T) {
        if i < 0 || i > self.len { panic("insert index {i} out of bounds for list of length {self.len}") }
        self.reserve(self.len + 1)
        __array_copy(self.data, i + 1, self.data, i, self.len - i)
        __array_set(self.data, i, v)
        self.len += 1
    }
    pub fn remove(self, i: Int) -> T {
        self.check(i)
        let v = __array_get(self.data, i)
        __array_copy(self.data, i, self.data, i + 1, self.len - i - 1)
        self.len -= 1
        v
    }
    pub fn clear(self) { self.len = 0 }
    pub fn truncate(self, n: Int) {
        if n < self.len && n >= 0 { self.len = n }
    }
    pub fn swap(self, i: Int, j: Int) {
        self.check(i)
        self.check(j)
        let t = __array_get(self.data, i)
        __array_set(self.data, i, __array_get(self.data, j))
        __array_set(self.data, j, t)
    }
    pub fn extend(self, other: List<T>) {
        let n = other.len
        self.reserve(self.len + n)
        __array_copy(self.data, self.len, other.data, 0, n)
        self.len += n
    }
    pub fn concat(self, other: List<T>) -> List<T> {
        let out: List<T> = List.with_capacity(self.len + other.len)
        out.extend(self)
        out.extend(other)
        out
    }
    pub fn copy(self) -> List<T> { self.slice(0, self.len) }
    pub fn slice(self, a: Int, b: Int) -> List<T> {
        if a < 0 || b > self.len || a > b { panic("slice {a}..{b} out of bounds for list of length {self.len}") }
        let nd: Array<T> = __array_new(b - a)
        __array_copy(nd, 0, self.data, a, b - a)
        List { len: b - a, data: nd }
    }
    pub fn take(self, n: Int) -> List<T> { self.slice(0, if n < self.len { n } else { self.len }) }
    pub fn skip(self, n: Int) -> List<T> { self.slice(if n < self.len { n } else { self.len }, self.len) }
    pub fn view(self) -> ListView<T> { ListView { list: self } }
    pub fn enumerate(self) -> Enumerated<ListIter<T>, T> { self.iter().enumerate() }
    pub fn map<U>(self, f: fn(T) -> U) -> List<U> {
        let out: List<U> = List.with_capacity(self.len)
        var i = 0
        while i < self.len {
            out.push(f(__array_get(self.data, i)))
            i += 1
        }
        out
    }
    pub fn filter(self, f: fn(T) -> Bool) -> List<T> {
        let out: List<T> = List.new()
        for x in self {
            if f(x) { out.push(x) }
        }
        out
    }
    pub fn flat_map<U>(self, f: fn(T) -> List<U>) -> List<U> {
        let out: List<U> = List.new()
        for x in self { out.extend(f(x)) }
        out
    }
    pub fn filter_map<U>(self, f: fn(T) -> Option<U>) -> List<U> {
        let out: List<U> = List.new()
        for x in self {
            if let Some(y) = f(x) { out.push(y) }
        }
        out
    }
    pub fn for_each(self, f: fn(T)) {
        for x in self { f(x) }
    }
    pub fn fold<B>(self, init: B, f: fn(B, T) -> B) -> B {
        var acc = init
        for x in self { acc = f(acc, x) }
        acc
    }
    pub fn any(self, f: fn(T) -> Bool) -> Bool {
        for x in self {
            if f(x) { return true }
        }
        false
    }
    pub fn all(self, f: fn(T) -> Bool) -> Bool {
        for x in self {
            if !f(x) { return false }
        }
        true
    }
    pub fn count(self, f: fn(T) -> Bool) -> Int {
        var n = 0
        for x in self {
            if f(x) { n += 1 }
        }
        n
    }
    pub fn find(self, f: fn(T) -> Bool) -> Option<T> {
        for x in self {
            if f(x) { return Some(x) }
        }
        None
    }
    pub fn position(self, f: fn(T) -> Bool) -> Option<Int> {
        var i = 0
        while i < self.len {
            if f(__array_get(self.data, i)) { return Some(i) }
            i += 1
        }
        None
    }
    pub fn zip<U>(self, other: List<U>) -> List<(T, U)> {
        let n = if self.len < other.len { self.len } else { other.len }
        let out: List<(T, U)> = List.with_capacity(n)
        var i = 0
        while i < n {
            out.push((__array_get(self.data, i), __array_get(other.data, i)))
            i += 1
        }
        out
    }
    pub fn reverse(self) {
        var i = 0
        var j = self.len - 1
        while i < j {
            let t = __array_get(self.data, i)
            __array_set(self.data, i, __array_get(self.data, j))
            __array_set(self.data, j, t)
            i += 1
            j -= 1
        }
    }
    pub fn reversed(self) -> List<T> {
        let out = self.copy()
        out.reverse()
        out
    }
    /// Stable merge sort using a comparison function.
    pub fn sort_by(self, cmp: fn(T, T) -> Ordering) {
        // stable bottom-up merge sort
        let n = self.len
        if n < 2 { return }
        var src = self.data
        var dst: Array<T> = __array_new(n)
        var width = 1
        while width < n {
            var lo = 0
            while lo < n {
                let mid = if lo + width < n { lo + width } else { n }
                let hi = if mid + width < n { mid + width } else { n }
                var i = lo
                var j = mid
                var k = lo
                // branch-free merge step: which side to take is data dependent and
                // unpredictable, so select the value and advance both indices arithmetically
                while i < mid && j < hi {
                    let a = __array_get(src, i)
                    let b = __array_get(src, j)
                    let left = !(cmp(b, a).is_lt())
                    __array_set(dst, k, __select(left, a, b))
                    i += __select(left, 1, 0)
                    j += __select(left, 0, 1)
                    k += 1
                }
                if i < mid {
                    __array_copy(dst, k, src, i, mid - i)
                } else if j < hi {
                    __array_copy(dst, k, src, j, hi - j)
                }
                lo = hi
            }
            let t = src
            src = dst
            dst = t
            width *= 2
        }
        self.data = src
    }
    pub fn sort_by_key<K: Ord>(self, key: fn(T) -> K) {
        self.sort_by(|a, b| key(a).cmp(key(b)))
    }
    pub fn sort(self) {
        // the same merge sort as sort_by, comparing with `<` directly: generic code is
        // elaborated per type, so for numbers this is one instruction instead of a call
        let n = self.len
        if n < 2 { return }
        if __is_int<T>() {
            // integers sort by radix, which is stable as well and does no comparisons
            if n >= 256 {
                self.__radix_sort()
                return
            }
        }
        var src = self.data
        var dst: Array<T> = __array_new(n)
        var width = 1
        while width < n {
            var lo = 0
            while lo < n {
                let mid = if lo + width < n { lo + width } else { n }
                let hi = if mid + width < n { mid + width } else { n }
                var i = lo
                var j = mid
                var k = lo
                // branch-free merge step: which side to take is data dependent and
                // unpredictable, so select the value and advance both indices arithmetically
                while i < mid && j < hi {
                    let a = __array_get(src, i)
                    let b = __array_get(src, j)
                    let left = !(b < a)
                    __array_set(dst, k, __select(left, a, b))
                    i += __select(left, 1, 0)
                    j += __select(left, 0, 1)
                    k += 1
                }
                if i < mid {
                    __array_copy(dst, k, src, i, mid - i)
                } else if j < hi {
                    __array_copy(dst, k, src, j, hi - j)
                }
                lo = hi
            }
            let t = src
            src = dst
            dst = t
            width *= 2
        }
        self.data = src
    }
    /// LSD radix sort on the bytes of an integer element type (only called for integers).
    fn __radix_sort(self) {
        let n = self.len
        let bytes = __int_bits<T>() / 8
        // flipping the sign bit makes signed order the unsigned order of the bit patterns
        let one: U64 = 1
        let flip: U64 = if __int_signed<T>() { one << __cast<Int, U64>(bytes * 8 - 1) } else { 0 }
        let top = one << __cast<Int, U64>(bytes * 8 - 1)
        let mask: U64 = top | (top - 1)
        var src = self.data
        var dst: Array<T> = __array_new(n)
        let counts: Array<Int> = __array_new(256 * bytes)
        var i = 0
        while i < n {
            let k = (__cast<T, U64>(__array_get(src, i)) ^ flip) & mask
            var p = 0
            while p < bytes {
                let c = p * 256 + __cast<U64, Int>((k >> __cast<Int, U64>(p * 8)) & 255)
                __array_set(counts, c, __array_get(counts, c) + 1)
                p += 1
            }
            i += 1
        }
        var p = 0
        while p < bytes {
            let base = p * 256
            let shift = __cast<Int, U64>(p * 8)
            let first = __cast<U64, Int>((((__cast<T, U64>(__array_get(src, 0)) ^ flip) & mask) >> shift) & 255)
            // a pass where every element has the same byte changes nothing
            if __array_get(counts, base + first) != n {
                var sum = 0
                var b = 0
                while b < 256 {
                    let c = __array_get(counts, base + b)
                    __array_set(counts, base + b, sum)
                    sum += c
                    b += 1
                }
                i = 0
                while i < n {
                    let x = __array_get(src, i)
                    let d = base + __cast<U64, Int>((((__cast<T, U64>(x) ^ flip) & mask) >> shift) & 255)
                    let o = __array_get(counts, d)
                    __array_set(dst, o, x)
                    __array_set(counts, d, o + 1)
                    i += 1
                }
                let t = src
                src = dst
                dst = t
            }
            p += 1
        }
        self.data = src
    }
    pub fn sorted(self) -> List<T> {
        let out = self.copy()
        out.sort()
        out
    }
    pub fn contains(self, v: T) -> Bool {
        for x in self {
            if x == v { return true }
        }
        false
    }
    pub fn index_of(self, v: T) -> Option<Int> {
        var i = 0
        while i < self.len {
            if __array_get(self.data, i) == v { return Some(i) }
            i += 1
        }
        None
    }
    pub fn min(self) -> Option<T> { self.iter().min() }
    pub fn max(self) -> Option<T> { self.iter().max() }
    pub fn dedup(self) -> List<T> {
        let out: List<T> = List.new()
        for x in self {
            match out.last() {
                Some(y) -> if x != y { out.push(x) }
                None -> out.push(x)
            }
        }
        out
    }
}

impl List<Str> {
    pub fn join(self, sep: Str) -> Str {
        let b = StrBuilder.new()
        var i = 0
        while i < self.len {
            if i > 0 { b.push(sep) }
            b.push(__array_get(self.data, i))
            i += 1
        }
        b.to_str()
    }
}

impl List<Int> {
    pub fn sum(self) -> Int { self.fold(0, |a, b| a + b) }
}
impl List<I64> {
    pub fn sum(self) -> I64 { self.fold(0, |a, b| a + b) }
}
impl List<Float> {
    pub fn sum(self) -> Float { self.fold(0.0, |a, b| a + b) }
}

impl<T> Index<Int, T> for List<T> {
    fn index(self, i: Int) -> T {
        self.check(i)
        __array_get(self.data, i)
    }
    fn set_index(self, i: Int, v: T) {
        self.check(i)
        __array_set(self.data, i, v)
    }
}

impl<T: Show> Show for List<T> {
    fn show(self) -> Str {
        let b = StrBuilder.new()
        b.push("[")
        var i = 0
        while i < self.len {
            if i > 0 { b.push(", ") }
            b.push(__array_get(self.data, i).show_nested())
            i += 1
        }
        b.push("]")
        b.to_str()
    }
}

impl<T: Eq> Eq for List<T> {
    fn eq(self, other: List<T>) -> Bool {
        if self.len != other.len { return false }
        var i = 0
        while i < self.len {
            if __array_get(self.data, i) != __array_get(other.data, i) { return false }
            i += 1
        }
        true
    }
}

impl<T: Ord> Ord for List<T> {
    fn cmp(self, other: List<T>) -> Ordering {
        var i = 0
        while i < self.len && i < other.len {
            let c = __array_get(self.data, i).cmp(__array_get(other.data, i))
            if !c.is_eq() { return c }
            i += 1
        }
        self.len.cmp(other.len)
    }
}

impl<T: Hash> Hash for List<T> {
    fn hash(self) -> Int {
        var h = self.len
        for x in self { h = __hash_mix(h, x.hash()) }
        h
    }
}

impl<T: Transfer> Transfer for List<T> {
    fn __enc(self, b: StrBuilder) {
        __enc_int(b, __cast<Int, I64>(self.len()))
        for x in self { x.__enc(b) }
    }
    fn __dec(r: __Reader) -> List<T> {
        let n = r.int()
        let out: List<T> = List.with_capacity(n)
        for _ in 0..n { out.push(T.__dec(r)) }
        out
    }
}

/// A read-only view of a list.
pub struct ListView<T> {
    list: List<T>
}

impl<T> ListView<T> {
    pub fn len(self) -> Int { self.list.len }
    pub fn is_empty(self) -> Bool { self.list.len == 0 }
    pub fn get(self, i: Int) -> Option<T> { self.list.get(i) }
    pub fn first(self) -> Option<T> { self.list.first() }
    pub fn last(self) -> Option<T> { self.list.last() }
    pub fn to_list(self) -> List<T> { self.list.copy() }
    pub fn map<U>(self, f: fn(T) -> U) -> List<U> { self.list.map(f) }
    pub fn filter(self, f: fn(T) -> Bool) -> List<T> { self.list.filter(f) }
    pub fn contains(self, v: T) -> Bool { self.list.contains(v) }
    pub fn enumerate(self) -> Enumerated<ListIter<T>, T> { self.list.enumerate() }
}
impl<T> Iterable for ListView<T> {
    type Iter = ListIter<T>
    fn iter(self) -> ListIter<T> { self.list.iter() }
}
impl<T> Index<Int, T> for ListView<T> {
    fn index(self, i: Int) -> T { self.list[i] }
}
impl<T: Show> Show for ListView<T> {
    fn show(self) -> Str { self.list.show() }
}
impl<T: Eq> Eq for ListView<T> {
    fn eq(self, other: ListView<T>) -> Bool { self.list == other.list }
}

// ---------------------------------------------------------------- Map

/// A hash map that preserves insertion order.
pub struct Map<K, V> {
    var keys: Array<K>
    var vals: Array<V>
    var live: Array<Bool>
    var used: Int
    var count: Int
    var slots: Array<Int>
}

impl<K: Eq + Hash, V> Map<K, V> {
    pub fn new() -> Map<K, V> {
        Map { keys: __array_new(0), vals: __array_new(0), live: __array_new(0), used: 0, count: 0, slots: __array_new(0) }
    }
    pub fn len(self) -> Int { self.count }
    pub fn is_empty(self) -> Bool { self.count == 0 }
    fn find(self, k: K) -> Int {
        let ns = __array_len(self.slots)
        if ns == 0 { return -1 }
        let mask = ns - 1
        var i = k.hash() & mask
        loop {
            let s = __array_get(self.slots, i)
            if s == 0 { return -1 }
            // a positive slot always points at a live entry: removal turns the slot into -1
            if s > 0 && __array_get(self.keys, s - 1) == k { return s - 1 }
            i = (i + 1) & mask
        }
    }
    fn place(self, k: K, e: Int) {
        let mask = __array_len(self.slots) - 1
        var i = k.hash() & mask
        while __array_get(self.slots, i) > 0 {
            i = (i + 1) & mask
        }
        __array_set(self.slots, i, e + 1)
    }
    fn rehash(self, want: Int) {
        var cap = 8
        while cap < want * 2 { cap *= 2 }
        let nk: Array<K> = __array_new(cap)
        let nv: Array<V> = __array_new(cap)
        let nl: Array<Bool> = __array_new(cap)
        var j = 0
        var i = 0
        while i < self.used {
            if __array_get(self.live, i) {
                __array_set(nk, j, __array_get(self.keys, i))
                __array_set(nv, j, __array_get(self.vals, i))
                __array_set(nl, j, true)
                j += 1
            }
            i += 1
        }
        self.keys = nk
        self.vals = nv
        self.live = nl
        self.used = j
        self.slots = __array_new(cap * 2)
        var e = 0
        while e < j {
            self.place(__array_get(nk, e), e)
            e += 1
        }
    }
    /// Inserts a value, returning the previous value for the key.
    pub fn insert(self, k: K, v: V) -> Option<V> {
        // one probe sequence finds either the key or the empty slot a new entry goes to;
        // slots outnumber entries two to one, so an empty slot always exists
        let ns = __array_len(self.slots)
        if ns > 0 {
            let mask = ns - 1
            var i = k.hash() & mask
            loop {
                let s = __array_get(self.slots, i)
                if s == 0 { break }
                if s > 0 && __array_get(self.keys, s - 1) == k {
                    let old = __array_get(self.vals, s - 1)
                    __array_set(self.vals, s - 1, v)
                    return Some(old)
                }
                i = (i + 1) & mask
            }
            let n = self.used
            if n < __array_len(self.keys) {
                __array_set(self.keys, n, k)
                __array_set(self.vals, n, v)
                __array_set(self.live, n, true)
                self.used = n + 1
                self.count += 1
                __array_set(self.slots, i, n + 1)
                return None
            }
        }
        if self.used >= __array_len(self.keys) {
            self.rehash(self.count + 1)
        }
        let n = self.used
        __array_set(self.keys, n, k)
        __array_set(self.vals, n, v)
        __array_set(self.live, n, true)
        self.used = n + 1
        self.count += 1
        self.place(k, n)
        None
    }
    pub fn get(self, k: K) -> Option<V> {
        let e = self.find(k)
        if e < 0 { None } else { Some(__array_get(self.vals, e)) }
    }
    pub fn get_or(self, k: K, default: V) -> V { self.get(k).unwrap_or(default) }
    pub fn contains_key(self, k: K) -> Bool { self.find(k) >= 0 }
    pub fn remove(self, k: K) -> Option<V> {
        let e = self.find(k)
        if e < 0 { return None }
        __array_set(self.live, e, false)
        let mask = __array_len(self.slots) - 1
        var i = k.hash() & mask
        while __array_get(self.slots, i) != e + 1 {
            i = (i + 1) & mask
        }
        __array_set(self.slots, i, -1)
        self.count -= 1
        Some(__array_get(self.vals, e))
    }
    pub fn clear(self) {
        self.keys = __array_new(0)
        self.vals = __array_new(0)
        self.live = __array_new(0)
        self.slots = __array_new(0)
        self.used = 0
        self.count = 0
    }
    pub fn keys(self) -> List<K> {
        let out: List<K> = List.with_capacity(self.count)
        var i = 0
        while i < self.used {
            if __array_get(self.live, i) { out.push(__array_get(self.keys, i)) }
            i += 1
        }
        out
    }
    pub fn values(self) -> List<V> {
        let out: List<V> = List.with_capacity(self.count)
        var i = 0
        while i < self.used {
            if __array_get(self.live, i) { out.push(__array_get(self.vals, i)) }
            i += 1
        }
        out
    }
    pub fn entries(self) -> List<(K, V)> {
        let out: List<(K, V)> = List.with_capacity(self.count)
        var i = 0
        while i < self.used {
            if __array_get(self.live, i) { out.push((__array_get(self.keys, i), __array_get(self.vals, i))) }
            i += 1
        }
        out
    }
    pub fn view(self) -> MapView<K, V> { MapView { map: self } }
}

impl<K: Eq + Hash, V> Iterable for Map<K, V> {
    type Iter = ListIter<(K, V)>
    fn iter(self) -> ListIter<(K, V)> { self.entries().iter() }
}

impl<K: Eq + Hash, V> Index<K, V> for Map<K, V> {
    fn index(self, k: K) -> V {
        match self.get(k) {
            Some(v) -> v
            None -> panic("key not found in map")
        }
    }
    fn set_index(self, k: K, v: V) {
        self.insert(k, v)
    }
}

impl<K: Eq + Hash + Show, V: Show> Show for Map<K, V> {
    fn show(self) -> Str {
        if self.count == 0 { return "[:]" }
        let b = StrBuilder.new()
        b.push("[")
        var first = true
        for (k, v) in self {
            if !first { b.push(", ") }
            first = false
            b.push(k.show_nested())
            b.push(": ")
            b.push(v.show_nested())
        }
        b.push("]")
        b.to_str()
    }
}

impl<K: Eq + Hash, V: Eq> Eq for Map<K, V> {
    fn eq(self, other: Map<K, V>) -> Bool {
        if self.count != other.count { return false }
        for (k, v) in self {
            match other.get(k) {
                Some(w) -> if v != w { return false }
                None -> return false
            }
        }
        true
    }
}

/// A read-only view of a map.
pub struct MapView<K, V> {
    map: Map<K, V>
}

impl<K: Eq + Hash, V> MapView<K, V> {
    pub fn len(self) -> Int { self.map.len() }
    pub fn is_empty(self) -> Bool { self.map.is_empty() }
    pub fn get(self, k: K) -> Option<V> { self.map.get(k) }
    pub fn contains_key(self, k: K) -> Bool { self.map.contains_key(k) }
    pub fn keys(self) -> List<K> { self.map.keys() }
    pub fn values(self) -> List<V> { self.map.values() }
    pub fn entries(self) -> List<(K, V)> { self.map.entries() }
}
impl<K: Eq + Hash, V> Iterable for MapView<K, V> {
    type Iter = ListIter<(K, V)>
    fn iter(self) -> ListIter<(K, V)> { self.map.iter() }
}
impl<K: Eq + Hash, V> Index<K, V> for MapView<K, V> {
    fn index(self, k: K) -> V { self.map[k] }
}
impl<K: Eq + Hash + Show, V: Show> Show for MapView<K, V> {
    fn show(self) -> Str { self.map.show() }
}

// ---------------------------------------------------------------- Set

/// A hash set that preserves insertion order.
pub struct Set<T> {
    map: Map<T, ()>
}

impl<T: Eq + Hash> Set<T> {
    pub fn new() -> Set<T> { Set { map: Map.new() } }
    pub fn from(items: List<T>) -> Set<T> {
        let s: Set<T> = Set.new()
        for x in items { s.insert(x) }
        s
    }
    pub fn len(self) -> Int { self.map.len() }
    pub fn is_empty(self) -> Bool { self.map.is_empty() }
    /// Adds a value; returns true if it was not already present.
    pub fn insert(self, v: T) -> Bool { self.map.insert(v, ()).is_none() }
    pub fn contains(self, v: T) -> Bool { self.map.contains_key(v) }
    pub fn remove(self, v: T) -> Bool { self.map.remove(v).is_some() }
    pub fn clear(self) { self.map.clear() }
    pub fn to_list(self) -> List<T> { self.map.keys() }
    pub fn union(self, other: Set<T>) -> Set<T> {
        let out = Set.from(self.to_list())
        for x in other { out.insert(x) }
        out
    }
    pub fn intersection(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set.new()
        for x in self {
            if other.contains(x) { out.insert(x) }
        }
        out
    }
    pub fn difference(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set.new()
        for x in self {
            if !other.contains(x) { out.insert(x) }
        }
        out
    }
    pub fn view(self) -> SetView<T> { SetView { set: self } }
}

impl<T: Eq + Hash> Iterable for Set<T> {
    type Iter = ListIter<T>
    fn iter(self) -> ListIter<T> { self.map.keys().iter() }
}

impl<T: Eq + Hash + Show> Show for Set<T> {
    fn show(self) -> Str {
        let b = StrBuilder.new()
        b.push("Set\{")
        var first = true
        for x in self {
            if !first { b.push(", ") }
            first = false
            b.push(x.show_nested())
        }
        b.push("\}")
        b.to_str()
    }
}

impl<T: Eq + Hash> Eq for Set<T> {
    fn eq(self, other: Set<T>) -> Bool {
        if self.len() != other.len() { return false }
        for x in self {
            if !other.contains(x) { return false }
        }
        true
    }
}

/// A read-only view of a set.
pub struct SetView<T> {
    set: Set<T>
}

impl<T: Eq + Hash> SetView<T> {
    pub fn len(self) -> Int { self.set.len() }
    pub fn is_empty(self) -> Bool { self.set.is_empty() }
    pub fn contains(self, v: T) -> Bool { self.set.contains(v) }
    pub fn to_list(self) -> List<T> { self.set.to_list() }
}
impl<T: Eq + Hash> Iterable for SetView<T> {
    type Iter = ListIter<T>
    fn iter(self) -> ListIter<T> { self.set.iter() }
}
impl<T: Eq + Hash + Show> Show for SetView<T> {
    fn show(self) -> Str { self.set.show() }
}

// ---------------------------------------------------------------- Range

pub struct Range<T> {
    start: T
    end: T
    inclusive: Bool
}

pub struct RangeIter<T> {
    var cur: T
    end: T
    inclusive: Bool
    var done: Bool
}

impl<T> Iterator for RangeIter<T> {
    type Item = T
    fn next(self) -> Option<T> {
        if self.done { return None }
        let c = self.cur
        if self.inclusive {
            if c > self.end {
                self.done = true
                return None
            }
            if c == self.end { self.done = true } else { self.cur = c + 1 }
        } else {
            if c >= self.end {
                self.done = true
                return None
            }
            self.cur = c + 1
        }
        Some(c)
    }
    fn fold<B>(self, init: B, f: fn(B, T) -> B) -> B {
        var acc = init
        if self.done { return acc }
        var c = self.cur
        while c < self.end {
            acc = f(acc, c)
            c = c + 1
        }
        // the inclusive end is visited without incrementing past it, so `..=MAX` cannot overflow
        if self.inclusive && c == self.end { acc = f(acc, c) }
        self.cur = c
        self.done = true
        acc
    }
}

impl<T> Iterable for Range<T> {
    type Iter = RangeIter<T>
    fn iter(self) -> RangeIter<T> { RangeIter { cur: self.start, end: self.end, inclusive: self.inclusive, done: false } }
}

impl<T> Range<T> {
    pub fn start(self) -> T { self.start }
    pub fn end(self) -> T { self.end }
    pub fn contains(self, x: T) -> Bool {
        x >= self.start && (if self.inclusive { x <= self.end } else { x < self.end })
    }
    pub fn to_list(self) -> List<T> { self.iter().collect() }
    pub fn map<U>(self, f: fn(T) -> U) -> Mapped<RangeIter<T>, T, U> { self.iter().map(f) }
    pub fn filter(self, f: fn(T) -> Bool) -> Filtered<RangeIter<T>, T> { self.iter().filter(f) }
    pub fn for_each(self, f: fn(T)) { self.iter().for_each(f) }
    pub fn fold<B>(self, init: B, f: fn(B, T) -> B) -> B { self.iter().fold(init, f) }
    pub fn any(self, f: fn(T) -> Bool) -> Bool { self.iter().any(f) }
    pub fn all(self, f: fn(T) -> Bool) -> Bool { self.iter().all(f) }
    pub fn count(self) -> Int { self.iter().count() }
    pub fn rev(self) -> List<T> { self.to_list().reversed() }
}

impl<T: Show> Show for Range<T> {
    fn show(self) -> Str {
        if self.inclusive { "{self.start}..={self.end}" } else { "{self.start}..{self.end}" }
    }
}

// ---------------------------------------------------------------- errors

/// Wraps any value that implements `Error`.
pub struct AnyErr {
    inner: dyn Error
}

impl<E: Error> From<E> for AnyErr {
    fn from(e: E) -> AnyErr { AnyErr { inner: e } }
}

impl AnyErr {
    pub fn new<E: Error>(e: E) -> AnyErr { AnyErr { inner: e } }
    pub fn msg(m: Str) -> AnyErr { AnyErr { inner: m } }
    pub fn downcast<E>(self) -> Option<E> {
        if __dyn_is<E, dyn Error>(self.inner) { Some(__dyn_cast<E, dyn Error>(self.inner)) } else { None }
    }
    pub fn inner(self) -> dyn Error { self.inner }
}

impl Show for AnyErr {
    fn show(self) -> Str { self.inner.show() }
}

impl Error for AnyErr {
    fn source(self) -> Option<dyn Error> { self.inner.source() }
}

impl Transfer for Bool {
    fn __enc(self, b: StrBuilder) { b.push_byte(if self { 49 } else { 48 }) }
    fn __dec(r: __Reader) -> Bool {
        r.pos += 1
        __str_byte(r.s, r.pos - 1) == 49
    }
}

impl Transfer for Char {
    fn __enc(self, b: StrBuilder) { __enc_int(b, __cast<U32, I64>(self.to_u32())) }
    fn __dec(r: __Reader) -> Char { Char.from_u32(__cast<I64, U32>(r.i64())).expect("malformed worker message") }
}

impl Transfer for Str {
    fn __enc(self, b: StrBuilder) {
        __enc_int(b, __cast<Int, I64>(__str_len(self)))
        b.push(self)
    }
    fn __dec(r: __Reader) -> Str { r.str() }
}

impl Transfer for () {
    fn __enc(self, b: StrBuilder) {}
    fn __dec(r: __Reader) -> () { () }
}

impl<T: Transfer> Transfer for Option<T> {
    fn __enc(self, b: StrBuilder) {
        match self {
            Some(v) -> {
                b.push_byte(49)
                v.__enc(b)
            }
            None -> b.push_byte(48)
        }
    }
    fn __dec(r: __Reader) -> Option<T> {
        r.pos += 1
        if __str_byte(r.s, r.pos - 1) == 49 { Some(T.__dec(r)) } else { None }
    }
}

impl<T: Transfer, E: Transfer> Transfer for Result<T, E> {
    fn __enc(self, b: StrBuilder) {
        match self {
            Ok(v) -> {
                b.push_byte(48)
                v.__enc(b)
            }
            Err(e) -> {
                b.push_byte(49)
                e.__enc(b)
            }
        }
    }
    fn __dec(r: __Reader) -> Result<T, E> {
        r.pos += 1
        if __str_byte(r.s, r.pos - 1) == 48 { Ok(T.__dec(r)) } else { Err(E.__dec(r)) }
    }
}

impl<K: Transfer, V: Transfer> Transfer for Map<K, V> {
    fn __enc(self, b: StrBuilder) {
        __enc_int(b, __cast<Int, I64>(self.len()))
        for (k, v) in self {
            k.__enc(b)
            v.__enc(b)
        }
    }
    fn __dec(r: __Reader) -> Map<K, V> {
        let n = r.int()
        let m: Map<K, V> = Map.new()
        for _ in 0..n {
            let k = K.__dec(r)
            m.insert(k, V.__dec(r))
        }
        m
    }
}

impl<T: Transfer> Transfer for Set<T> {
    fn __enc(self, b: StrBuilder) {
        __enc_int(b, __cast<Int, I64>(self.len()))
        for x in self { x.__enc(b) }
    }
    fn __dec(r: __Reader) -> Set<T> {
        let n = r.int()
        let out: Set<T> = Set.new()
        for _ in 0..n { out.insert(T.__dec(r)) }
        out
    }
}

impl<A: Transfer, B: Transfer> Transfer for (A, B) {
    fn __enc(self, b: StrBuilder) {
        self.0.__enc(b)
        self.1.__enc(b)
    }
    fn __dec(r: __Reader) -> (A, B) {
        let a = A.__dec(r)
        (a, B.__dec(r))
    }
}

impl<A: Transfer, B: Transfer, C: Transfer> Transfer for (A, B, C) {
    fn __enc(self, b: StrBuilder) {
        self.0.__enc(b)
        self.1.__enc(b)
        self.2.__enc(b)
    }
    fn __dec(r: __Reader) -> (A, B, C) {
        let a = A.__dec(r)
        let b = B.__dec(r)
        (a, b, C.__dec(r))
    }
}

// ---------------------------------------------------------------- async

@intrinsic("host_async") fn __host_async(op: Int, arg: Str) -> Str

// ---- linear memory access for the canonical ABI (component targets)
@intrinsic("mem_load") fn __mem_load<T>(addr: I32) -> T
@intrinsic("mem_store") fn __mem_store<T>(addr: I32, v: T)
@intrinsic("cabi_alloc") fn __cabi_alloc(size: I32, align: I32) -> I32
@intrinsic("cabi_mark") fn __cabi_mark() -> I32
@intrinsic("cabi_reset") fn __cabi_reset(mark: I32)
@intrinsic("cabi_base") fn __cabi_base() -> I32
@intrinsic("str_to_mem") fn __str_to_mem(s: Str) -> I32
@intrinsic("str_from_mem") fn __str_from_mem(ptr: I32, len: I32) -> Str

/// A `stream<T>` handle from a WIT interface.
@derive(Eq, Show)
pub struct __WitStream {
    pub handle: I32
}

/// A `future<T>` handle from a WIT interface.
@derive(Eq, Show)
pub struct __WitFuture {
    pub handle: I32
}
@intrinsic("global") fn __global<T>(init: T) -> T
@intrinsic("worker_dispatch") fn __worker_dispatch(entry: Int)
@intrinsic("is_err") fn __is_err<T>(v: T) -> Bool

/// Instance-wide runtime state.
struct __Rt {
    runners: List<fn()>
    callbacks: List<fn(Int)>
}

fn __rt() -> __Rt { __global(__Rt { runners: [], callbacks: [] }) }

@export("__run_task")
fn __run_task(id: Int) {
    let r = __rt()
    let f = r.runners[id]
    r.runners[id] = || {}
    f()
}

/// Registers a function the host can call back with an integer argument.
pub fn __register_callback(f: fn(Int)) -> Int {
    let r = __rt()
    r.callbacks.push(f)
    r.callbacks.len() - 1
}

@export("__callback")
fn __callback(id: Int, arg: Int) {
    let f = __rt().callbacks[id]
    f(arg)
}

fn __cancel_point() { __host(43, "") }

/// A lazy asynchronous computation; `.await` runs it to completion.
pub struct Future<T> {
    var run: Option<fn() -> T>
    var value: Option<T>
}

pub fn __future_new<T>(f: fn() -> T) -> Future<T> {
    Future { run: Some(f), value: None }
}

impl<T> Future<T> {
    /// A future that is already complete.
    pub fn ready(v: T) -> Future<T> { Future { run: None, value: Some(v) } }
    pub fn __await(self) -> T {
        __cancel_point()
        match self.value {
            Some(v) -> return v
            None -> {}
        }
        let f = self.run.expect("future awaited while it is already running")
        self.run = None
        let v = f()
        self.value = Some(v)
        v
    }
}

/// A child task started in a scope with `s.spawn(...)`. It runs concurrently
/// with its parent; `.await` waits for its result.
pub struct Task<T> {
    fut: Future<T>
    var id: Int
    var done: Bool
}

impl<T> Task<T> {
    pub fn __await(self) -> T {
        __cancel_point()
        if !self.done {
            __host_async(102, "{self.id}")
            __cancel_point()
        }
        match self.fut.value {
            Some(v) -> v
            None -> panic("awaited a task that was cancelled")
        }
    }
    /// Whether the task has finished.
    pub fn is_done(self) -> Bool { self.done }
}

/// A structured-concurrency scope; children cannot outlive it.
pub struct Scope {
    children: List<Int>
    workers: List<Int>
    var ended: Bool
}

impl Scope {
    /// Starts a child task that runs concurrently until the scope ends.
    pub fn spawn<T>(self, f: Future<T>) -> Task<T> {
        if self.ended { panic("spawn on a task scope that has already ended") }
        let t = Task { fut: f, id: 0, done: false }
        let r = __rt()
        r.runners.push(|| {
            t.fut.__await()
            t.done = true
        })
        let rid = r.runners.len() - 1
        t.id = __host(40, "{rid}").parse_int().unwrap()
        self.children.push(t.id)
        t
    }
    pub fn __start_worker<In: Transfer, Out: Transfer>(self, entry: Int) -> __Worker<In, Out> {
        if self.ended { panic("worker started on a task scope that has already ended") }
        let id = __host(50, "{entry}").parse_int().unwrap()
        self.workers.push(id)
        __Worker { id }
    }
    fn finish(self, failed: Bool) {
        if failed {
            for c in self.children { __host(41, "{c}") }
        }
        for c in self.children { __host_async(102, "{c}") }
        for w in self.workers { __host(52, "{w}") }
        self.ended = true
    }
}

pub struct TaskApi {}

impl TaskApi {
    /// Runs `body` with a new scope. The scope completes when all children
    /// have completed; if `body` returns an `Err`, unfinished children are cancelled.
    pub fn scope<T>(self, body: fn(Scope) -> Future<T>) -> Future<T> {
        __future_new(|| {
            let s = Scope { children: [], workers: [], ended: false }
            let r = body(s).__await()
            s.finish(__is_err(r))
            r
        })
    }
    /// Whether the current task has been cancelled.
    pub fn is_cancelled(self) -> Bool { __host(42, "") == "1" }
}

pub const task: TaskApi = TaskApi {}

/// The worker side of a worker's channel: receives `In`, sends `Out`.
pub struct __Port<In, Out> {}

impl<In: Transfer, Out: Transfer> __Port<In, Out> {
    /// Waits for the next message; `None` once the owner has closed the channel.
    pub async fn recv(self) -> Option<In> {
        let m = __host_async(104, "")
        if m == "" { None } else { Some(__transfer_decode(__str_slice(m, 1, __str_len(m)))) }
    }
    pub fn send(self, v: Out) { __host(53, __transfer_encode(v)) }
}

/// The owner side of a worker's channel: sends `In`, receives `Out`.
pub struct __Worker<In, Out> {
    id: Int
}

impl<In: Transfer, Out: Transfer> __Worker<In, Out> {
    pub fn send(self, v: In) { __host(51, "{self.id}\0{__transfer_encode(v)}") }
    /// Waits for the next message; `None` once the worker function has returned.
    pub async fn recv(self) -> Option<Out> {
        let m = __host_async(103, "{self.id}")
        if m == "" { None } else { Some(__transfer_decode(__str_slice(m, 1, __str_len(m)))) }
    }
}

pub fn __worker_main<In: Transfer, Out: Transfer>(f: fn(__Port<In, Out>) -> Future<()>) {
    f(__Port {}).__await()
    __host(54, "")
}
