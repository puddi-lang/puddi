// spec: 3.8
// host: node
fn main() {
    assert(Str.from_utf8([0xe0, 0x9f, 0xbf]).is_none())
    assert(Str.from_utf8([0xed, 0xa0, 0x80]).is_none())
    assert(Str.from_utf8([0xf0, 0x8f, 0xbf, 0xbf]).is_none())
    assert(Str.from_utf8([0xf4, 0x90, 0x80, 0x80]).is_none())
    assert(Str.from_utf8([0xf0, 0x90, 0x80]).is_none())
    assert_eq(Str.from_utf8([0xe0, 0xa0, 0x80]).unwrap(), "\u{800}")
    assert_eq(Str.from_utf8([0xf4, 0x8f, 0xbf, 0xbf]).unwrap(), "\u{10FFFF}")
}
