// spec: 2.4
// mode: check
// Naming convention violations are warnings, not errors.
struct bad_type { x: Int }
fn BadFunction() {}
const lower_const: Int = 1
fn main() {
    let BadLocal = 1
    BadFunction()
}
//~ warning: name `bad_type` should use UpperCamelCase
//~ warning: name `BadFunction` should use snake_case
//~ warning: name `lower_const` should use SCREAMING_SNAKE_CASE
